menu "Dou mirror"

    config DOU_MIRROR
        bool "Live screen, touch and keys over the console cable"
        depends on DOU_ENABLED && SPIRAM && !DOU_UI_FREEINK
        default n
        help
            tools/dou/mirror.py shows the screen and controls the board over
            its existing USB or UART console. Logs share the framed stream.
            The screen copies and message buffer use PSRAM. For development.

    config DOU_MIRROR_IRIS
        bool "Mirror over ESP-Iris on the ESP-Mosaico's USB-C"
        depends on DOU_MIRROR && DOU_BOARD_ESP_MOSAICO && ESP_IRIS_ENABLE
        default y
        help
            tools/dou/mirror.py iris:DEVICE_ID reaches the board on its ESP-Iris
            data port, the USB-C port Vibe Mode installs through; no Gateway.
            Builds with esp-mosaico-utils only
            (MOSAICO_UTILS, which tools/dou/board.sh passes).

    config DOU_VIRTUAL_DISPLAY_NAME
        string "Virtual display: name"
        depends on DOU_BOARD_VIRTUAL_DISPLAY
        default "Dou virtual display"
        help
            The viewer draws a known board around the screen when the name
            holds its model, "1.75C" for example.

    config DOU_VIRTUAL_DISPLAY_WIDTH
        int "Virtual display: width in pixels"
        depends on DOU_BOARD_VIRTUAL_DISPLAY
        range 64 800
        default 466

    config DOU_VIRTUAL_DISPLAY_HEIGHT
        int "Virtual display: height in pixels"
        depends on DOU_BOARD_VIRTUAL_DISPLAY
        range 64 800
        default 466

    config DOU_VIRTUAL_DISPLAY_ROUND
        bool "Virtual display: round"
        depends on DOU_BOARD_VIRTUAL_DISPLAY
        default y

    config DOU_VIRTUAL_DISPLAY_DIAGONAL
        int "Virtual display: diagonal in hundredths of an inch"
        depends on DOU_BOARD_VIRTUAL_DISPLAY
        range 50 1000
        default 175

endmenu
